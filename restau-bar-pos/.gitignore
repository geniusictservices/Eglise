# Configuration propre à chaque serveur et à chaque instance (contient des mots de passe)
/config/app.local.php
/config/instances/*.php
!/config/instances/exemple.php.dist
# Console super admin : accès à sa base (modèle : config/console.php.dist)
/config/console.php

# Journaux
/storage/logs/*
!/storage/logs/.gitkeep
# Preuve d'accès à l'hébergement pour la page d'installation de la console
/storage/console-installation.code
/storage/installation-*.txt

# Fichiers envoyés (photos des produits…)
/public/uploads/*
!/public/uploads/.gitkeep

# Documents du personnel (contrats, pièces d'identité) : hors de la racine web, jamais versionnés
/storage/documents/
