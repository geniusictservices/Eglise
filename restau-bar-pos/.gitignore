# Configuration propre à chaque serveur et à chaque instance (contient des mots de passe)
/config/app.local.php
/config/instances/*.php
!/config/instances/exemple.php.dist
# Console super admin : accès à sa base (modèle : config/console.php.dist)
/config/console.php

# Journaux
/storage/logs/*
!/storage/logs/.gitkeep
# Preuve d'accès à l'hébergement pour la page d'installation de la console
/storage/console-installation.code
/storage/installation-*.txt

# Fichiers envoyés (photos des produits…)
/public/uploads/*
!/public/uploads/.gitkeep

# Documents du personnel (contrats, pièces d'identité) : hors de la racine web, jamais versionnés
/storage/documents/

# Outils de test et du manuel : états et résultats produits en local
/outils/tests/instance.txt
/outils/tests/suites/instance.txt
/outils/tests/creer-integ.txt
/outils/tests/pristine.sql
/outils/tests/uploads-pristine/
/outils/tests/resultats/
/outils/manuel/instance.txt
/outils/manuel/pdf-tmp/
/outils/manuel/pages.json
/outils/**/*.log
/outils/**/*.pid
/outils/**/*.png
/outils/**/*.sql
/outils/**/*.pdf
/outils/tests/suites/dettes/nettoyage-caisse.json
/outils/tests/suites/agents/final/audit.json
/outils/tests/suites/dettes/console-integ.php
/outils/tests/suites/dettes/r[0-9].txt
/outils/tests/suites/agents/*/resultats.txt
